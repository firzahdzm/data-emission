[Unit]
Description=Gradient Emission Tracker (Bittensor subnet 56)
Documentation=file:///opt/emission-tracker/README.md
After=network-online.target emission-signer.service
Wants=network-online.target emission-signer.service

[Service]
Type=simple

# Adjust these to match your install
User=emission
Group=emission
WorkingDirectory=/opt/emission-tracker
EnvironmentFile=/opt/emission-tracker/.env

# Bind to localhost only; expose via nginx reverse proxy + auth
ExecStart=/opt/emission-tracker/.venv/bin/uvicorn \
    emission_tracker.main:create_app \
    --factory \
    --host 127.0.0.1 \
    --port 8000 \
    --log-level info

# Restart on failure, but back off so we don't hammer if config is broken
Restart=on-failure
RestartSec=10
StartLimitInterval=120
StartLimitBurst=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# The signer's socket directory. ProtectSystem=strict remounts everything
# outside /dev, /proc and /sys read-only — including /run — and connect() on
# a unix socket needs write permission on the inode, so without this every
# signed action fails with a 503.
ReadWritePaths=/opt/emission-tracker/data /opt/emission-tracker/logs /run/emission-signer

[Install]
WantedBy=multi-user.target
